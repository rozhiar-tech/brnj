rules_version = '2';

// Brnj — Firestore security rules.
//
// Two principles run through the whole file:
//   1. Nothing that affects ranking or reputation is client-writable. stats,
//      counts, score, verified, and roles are Function-owned. A client that
//      can write its own view count will write its own view count.
//   2. Guests are real (anonymous) users, so every rule can assume a uid.
//      Guests simply fail the isRegistered() check on anything social.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // Anonymous users are signed in but not registered. Browsing is free;
    // posting is not.
    function isRegistered() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Claiming the tick requires the token to say so; claiming *no* tick is
    // always allowed. Requiring exact equality looked stricter and was worse:
    // a custom claim only reaches a device when its ID token is reissued, so
    // a freshly verified account carried verified:true in its profile and
    // false in its token, and every write it made was refused until it signed
    // out. Losing your own badge for an hour is recoverable; being unable to
    // comment is not obviously a bug to the person it happens to.

    // Set by an admin Function only — never self-serve.
    //
    // Read through token.get() with a default: almost nobody has these claims,
    // and reaching for a key that isn't on the token makes the whole rule
    // error out rather than evaluate false. That failure mode is silent and
    // takes every rule composing it down with it.
    function isVerified() {
      return signedIn() && request.auth.token.get('verified', false) == true;
    }

    function isModerator() {
      return signedIn() && request.auth.token.get('moderator', false) == true;
    }

    // The fields a client may never write. Every content rule composes this.
    function noProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['stats', 'score', 'verified', 'counts', 'roles', 'tier']);
    }

    function noProtectedFieldsOnCreate() {
      return !request.resource.data.keys()
        .hasAny(['stats', 'score', 'counts', 'roles', 'tier']);
    }

    function isBlockedBy(ownerUid) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/blocked/$(request.auth.uid));
    }

    // The other party in a two-person conversation.
    function otherIn(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    // Admin of a chat, read from the chat document. Needed from inside the
    // messages subcollection, where `resource` is a message and the chat's own
    // isChatAdmin() has nothing to look at.
    function isChatAdminOf(chatId) {
      return signedIn()
             && exists(/databases/$(database)/documents/chats/$(chatId))
             && chatAdminCheck(get(/databases/$(database)/documents/chats/$(chatId)).data);
    }

    // Same rule as the chat's own isChatAdmin(), against a chat document read
    // from elsewhere. Groups and community rooms have admins; a DM does not,
    // and giving its creator admin powers would let them delete the other
    // person's messages.
    function chatAdminCheck(chat) {
      return (chat.kind == 'group'
              && (chat.createdBy == request.auth.uid
                  || chat.admins.hasAny([request.auth.uid])))
             || (chat.kind == 'community'
                 && isCommunityMod(chat.get('communityId', '')));
    }

    // ---- community helpers ------------------------------------------------
    //
    // These take the community id from the *path*, never from a result
    // document, so they stay constant across every document a query returns.
    // That is what makes them legal in a list rule — the lesson from the users
    // collection, where a lookup keyed on each result made people search
    // impossible to allow.

    function communityExists(cid) {
      return exists(/databases/$(database)/documents/communities/$(cid));
    }

    function communityDoc(cid) {
      return get(/databases/$(database)/documents/communities/$(cid)).data;
    }

    // Moderator authority is read from the community document only — the
    // `role` field on a member document is a label for the UI and grants
    // nothing. One source of truth means a forged role is cosmetic.
    function isCommunityMod(cid) {
      return signedIn()
             && communityExists(cid)
             && (communityDoc(cid).createdBy == request.auth.uid
                 || communityDoc(cid).moderators.hasAny([request.auth.uid]));
    }

    function isCommunityMember(cid) {
      return signedIn()
             && exists(/databases/$(database)/documents/communities/$(cid)/members/$(request.auth.uid));
    }

    // Private hides the contents, not the door: the community document itself
    // stays listable so someone can find it and ask to join.
    function communityContentVisible(cid) {
      return communityExists(cid)
             && (communityDoc(cid).privacy == 'public' || isCommunityMember(cid));
    }

    // ---- users ------------------------------------------------------------

    match /users/{uid} {
      // Opening one profile can afford the per-document block lookup.
      allow get: if signedIn() && !isBlockedBy(uid);

      // Listing cannot. Firestore evaluates a query's rule from the query's own
      // constraints, and an exists() lookup keyed on each result is not
      // something it can prove safe in advance — people search came back
      // permission-denied because of it.
      //
      // So a listing is limited to accounts that asked to be findable, which is
      // exactly what `discoverable` promises. Blocked people are filtered on the
      // client, where the block list already lives.
      allow list: if signedIn()
                  && resource.data.privacy.discoverable == true;

      allow create: if isSelf(uid)
                    && noProtectedFieldsOnCreate()
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 40;

      allow update: if isSelf(uid) && noProtectedFields();

      // Deletion goes through the Auth onDelete Function so the user's content
      // and viewer records are purged too.
      allow delete: if false;

      // Owner-only subcollections.
      match /tokens/{tokenId} {
        allow read, write: if isSelf(uid);
      }
      match /blocked/{blockedUid} {
        allow read, write: if isSelf(uid);
      }
      match /saved/{recipeId} {
        allow read, write: if isSelf(uid);
      }
      match /notifications/{id} {
        allow read, delete: if isSelf(uid);
        // Only the read flag is the owner's to change — the rest is what the
        // Function said happened.
        allow update: if isSelf(uid)
                      && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['read']);
        allow create: if false; // Functions only
      }
      match /stats/{day} {
        allow read: if isSelf(uid);
        allow write: if false; // Functions only
      }

      // Follow graph is public; you may only write your own edges.
      match /following/{targetUid} {
        allow read: if signedIn();
        allow write: if isSelf(uid) && isRegistered();
      }
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow write: if false; // mirrored by a Function
      }
    }

    // ---- handles ----------------------------------------------------------

    // One document per claimed handle, id = the handle itself. Uniqueness is a
    // property of the document id, not of a query, so two people claiming the
    // same name in the same instant cannot both succeed.
    match /handles/{handle} {
      // Public so the composer can tell you a name is taken before you submit.
      allow read: if true;

      // create fails if the document already exists, which is the whole
      // mechanism. Handles are never updated — changing one is a delete plus a
      // create, so the old name is genuinely released.
      allow create: if isRegistered()
                    && request.resource.data.uid == request.auth.uid
                    && handle.matches('^[a-z0-9_]{3,20}$');

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ---- recipes ----------------------------------------------------------

    match /recipes/{recipeId} {
      function isAuthor() {
        return signedIn() && resource.data.author.uid == request.auth.uid;
      }

      // Same null guard as plans: a listener attached to a recipe that has been
      // deleted, or a stale share link, should resolve to "not there" rather
      // than to a permission error.
      allow read: if signedIn()
                  && (resource == null
                      || resource.data.status == 'published'
                      || isAuthor()
                      || isModerator());

      // Size ceilings, applied to drafts and published recipes alike. These
      // bound what one document can cost; they say nothing about whether it is
      // finished.
      function withinLimits() {
        return request.resource.data.title is string
               && request.resource.data.title.size() <= 120
               && request.resource.data.ingredients.size() <= 80
               && request.resource.data.steps.size() <= 60
               && request.resource.data.keywords.size() <= 60;
      }

      // A draft is incomplete by definition. The composer creates one the
      // moment a cover photo is picked — before a title has been typed —
      // because autosave from the first interaction is the whole design.
      // Requiring a title to *exist* made picking a photo the first thing that
      // could fail.
      //
      // Completeness is a condition of publishing, not of saving.
      function completeEnoughToPublish() {
        return request.resource.data.status != 'published'
               || (request.resource.data.title.size() > 0
                   && request.resource.data.ingredients.size() > 0
                   && request.resource.data.steps.size() > 0);
      }

      allow create: if isRegistered()
                    && request.resource.data.author.uid == request.auth.uid
                    // The denormalised verified flag has to match the token,
                    // or anyone could mint themselves a boost.
                    && (request.resource.data.author.verified == false
                        || isVerified())
                    && noProtectedFieldsOnCreate()
                    && withinLimits()
                    && completeEnoughToPublish();

      allow update: if isAuthor()
                    && noProtectedFields()
                    && withinLimits()
                    && completeEnoughToPublish();
      allow delete: if isAuthor() || isModerator();

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isSelf(uid) && isRegistered();
        allow update: if false;
      }

      match /cooked/{uid} {
        allow read: if signedIn();
        // The author stub is denormalised so the gallery renders without a
        // lookup per entry — which means its verified flag has to be checked
        // against the token, exactly as it is on a recipe.
        allow create, update: if isSelf(uid)
                              && isRegistered()
                              && request.resource.data.author.uid == request.auth.uid
                              && (request.resource.data.author.verified == false
                        || isVerified());
        allow delete: if isSelf(uid) || isModerator();
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if isRegistered()
                      && request.resource.data.author.uid == request.auth.uid
                      && (request.resource.data.author.verified == false
                        || isVerified())
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
        allow update: if signedIn()
                      && resource.data.author.uid == request.auth.uid
                      && noProtectedFields();
        allow delete: if signedIn()
                      && (resource.data.author.uid == request.auth.uid
                          || get(/databases/$(database)/documents/recipes/$(recipeId)).data.author.uid == request.auth.uid
                          || isModerator());
      }

      // Who viewed. Readable only by the content's author — counts are public,
      // names are not. See the plan: a visible viewer list changes who is
      // willing to browse at all.
      match /viewers/{uid} {
        allow read: if get(/databases/$(database)/documents/recipes/$(recipeId)).data.author.uid == request.auth.uid
                    || isModerator();
        allow write: if false; // written by the aggregation Function
      }
    }

    // ---- weekly plans -----------------------------------------------------

    match /plans/{planId} {
      function isOwner() {
        return signedIn() && resource.data.owner.uid == request.auth.uid;
      }

      // Ownership from the document id, which works before the document
      // exists. The id is {uid}_{weekStart} and creation pins that prefix to
      // the caller, so the path is as trustworthy as the payload.
      function ownsPath() {
        return signedIn() && planId.split('_')[0] == request.auth.uid;
      }

      function follows(ownerUid) {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(ownerUid));
      }

      // The editor listens to the current user's plan document before it
      // exists — the first write happens when a dish is added, not when the
      // screen opens. For a missing document `resource` is null, so any rule
      // reaching for resource.data errors and the listener fails with
      // permission-denied instead of an empty snapshot. Hence the path check
      // first, and a null guard before every resource.data access.
      allow read: if ownsPath()
                  || isModerator()
                  || (resource != null && (
                       isOwner()
                       || resource.data.visibility == 'public'
                       || (resource.data.visibility == 'followers'
                           && follows(resource.data.owner.uid))
                     ));

      // The document id is {uid}_{weekStart}. Pinning the id to the caller's
      // uid is what makes one-plan-per-user-per-week true by construction,
      // with no query and no transaction.
      allow create: if isRegistered()
                    && request.resource.data.owner.uid == request.auth.uid
                    && planId.split('_')[0] == request.auth.uid
                    && (request.resource.data.owner.verified == false
                        || isVerified())
                    && noProtectedFieldsOnCreate()
                    && request.resource.data.days.size() == 7;

      allow update: if isOwner()
                    && noProtectedFields()
                    && request.resource.data.days.size() == 7;

      allow delete: if isOwner() || isModerator();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if isRegistered()
                      && request.resource.data.author.uid == request.auth.uid;
        allow update, delete: if signedIn()
                              && (resource.data.author.uid == request.auth.uid || isModerator());
      }

      match /viewers/{uid} {
        allow read: if get(/databases/$(database)/documents/plans/$(planId)).data.owner.uid == request.auth.uid
                    || isModerator();
        allow write: if false;
      }
    }

    // ---- view events ------------------------------------------------------

    // Clients append here; a Function aggregates into stats and viewers, then
    // deletes. Nobody reads this collection — it's a write-only queue.
    // ---- communities ------------------------------------------------------

    match /communities/{cid} {

      // Counters and ownership are not client business. Separate from the
      // global noProtectedFields() because the field names differ.
      function noCommunityCounters() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['memberCount', 'postCount', 'createdBy', 'createdAt']);
      }

      function communityWithinLimits() {
        return request.resource.data.name is string
               && request.resource.data.name.size() > 0
               && request.resource.data.name.size() <= 60
               && request.resource.data.get('description', '').size() <= 500
               && request.resource.data.rules.size() <= 10
               && request.resource.data.moderators.size() <= 20;
      }

      // Anyone signed in, guests included — browsing communities is how
      // someone decides the app is worth an account.
      allow read: if signedIn();

      allow create: if isRegistered()
                    && request.resource.data.createdBy == request.auth.uid
                    // No self-appointed co-moderators at creation, and no
                    // pre-seeded counters.
                    && request.resource.data.moderators.size() == 0
                    && !request.resource.data.keys()
                         .hasAny(['memberCount', 'postCount'])
                    && communityWithinLimits();

      // Settings, rules, and the moderator list. `moderators` is editable here
      // by design: promoting someone is a moderator action, and the only other
      // place it could live is a Function that does exactly this check.
      allow update: if isCommunityMod(cid)
                    && noCommunityCounters()
                    && communityWithinLimits();

      // Only the person who made it, or staff. A moderator who could delete
      // the community out from under its owner is a moderator with too much.
      allow delete: if (signedIn() && resource.data.createdBy == request.auth.uid)
                    || isModerator();

      // ---- membership -----------------------------------------------------

      match /members/{uid} {
        // Membership is public in a public community and members-only in a
        // private one — the same rule the posts follow.
        allow read: if communityContentVisible(cid) || isModerator();

        allow create: if isRegistered()
                      && request.resource.data.uid == uid
                      && request.resource.data.author.uid == uid
                      && (request.resource.data.author.verified == false
                          || isVerified())
                      && (
                        // Joining an open community, as yourself.
                        (isSelf(uid)
                         && communityExists(cid)
                         && communityDoc(cid).joinPolicy == 'open'
                         && request.resource.data.role == 'member')

                        // The creator's own row. The community document is
                        // created in the same batch, so it does not exist yet
                        // as far as this rule can see — get() reads committed
                        // state, not the batch. Allowing it only while the
                        // community is absent keeps the window to exactly that
                        // batch, and ids are server-random, so there is nothing
                        // to squat on.
                        || (isSelf(uid)
                            && !communityExists(cid)
                            && request.resource.data.role == 'owner')

                        // A moderator approving someone off the queue.
                        || (isCommunityMod(cid)
                            && request.resource.data.role == 'member')
                      );

        // Role changes are a moderator action. Nobody promotes themselves.
        allow update: if isCommunityMod(cid)
                      && request.resource.data.uid == resource.data.uid;

        // Leaving, or being removed. The owner is not allowed to vanish: a
        // community with nobody who can approve or promote is stuck.
        allow delete: if (isSelf(uid) || isCommunityMod(cid) || isModerator())
                      && !(communityExists(cid)
                           && communityDoc(cid).createdBy == uid);
      }

      // ---- the approval queue ---------------------------------------------

      match /requests/{uid} {
        // Moderators see the queue; you can see your own request, which is how
        // the join button knows to say "pending" instead of "join".
        allow read: if isSelf(uid) || isCommunityMod(cid) || isModerator();

        allow create: if isRegistered()
                      && isSelf(uid)
                      && request.resource.data.uid == uid
                      && request.resource.data.author.uid == uid
                      && (request.resource.data.author.verified == false
                          || isVerified())
                      && communityExists(cid)
                      && communityDoc(cid).joinPolicy == 'approval'
                      && !isCommunityMember(cid);

        allow update: if false;

        // Withdrawn by the asker, or cleared by a moderator on approve/reject.
        allow delete: if isSelf(uid) || isCommunityMod(cid) || isModerator();
      }

      // ---- posts ----------------------------------------------------------

      match /posts/{postId} {
        function isPostAuthor() {
          return signedIn() && resource.data.author.uid == request.auth.uid;
        }

        // resource == null so a listener on a deleted post resolves to "gone"
        // rather than to a permission error.
        allow read: if signedIn()
                    && (resource == null
                        || communityContentVisible(cid)
                        || isModerator());

        // Posting requires membership — in every community, public ones
        // included. A public community is readable by all and writable by its
        // members; that difference is the whole point of joining.
        allow create: if isRegistered()
                      && isCommunityMember(cid)
                      && request.resource.data.author.uid == request.auth.uid
                      && (request.resource.data.author.verified == false
                          || isVerified())
                      && request.resource.data.body is string
                      && request.resource.data.body.size() <= 5000
                      // Pinning is a moderator act, so a new post may only
                      // arrive pinned if a moderator wrote it.
                      && (request.resource.data.pinned == false
                          || isCommunityMod(cid))
                      && !request.resource.data.keys().hasAny(['commentCount']);

        allow update: if (
                        // The author may edit their words and nothing else.
                        (isPostAuthor()
                         && request.resource.data.pinned == resource.data.pinned
                         && request.resource.data.author.uid == resource.data.author.uid)
                        // A moderator may pin and unpin, and nothing else.
                        || (isCommunityMod(cid)
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['pinned']))
                      )
                      && !request.resource.data.diff(resource.data)
                           .affectedKeys().hasAny(['commentCount', 'createdAt']);

        allow delete: if isPostAuthor() || isCommunityMod(cid) || isModerator();

        match /comments/{commentId} {
          allow read: if signedIn()
                      && (communityContentVisible(cid) || isModerator());

          allow create: if isRegistered()
                        && isCommunityMember(cid)
                        && request.resource.data.author.uid == request.auth.uid
                        && (request.resource.data.author.verified == false
                            || isVerified())
                        && request.resource.data.text is string
                        && request.resource.data.text.size() > 0
                        && request.resource.data.text.size() <= 2000;

          allow update: if signedIn()
                        && resource.data.author.uid == request.auth.uid
                        && noProtectedFields();

          allow delete: if (signedIn()
                            && resource.data.author.uid == request.auth.uid)
                           || isCommunityMod(cid)
                           || isModerator();
        }
      }
    }

    // ---- chats ------------------------------------------------------------

    match /chats/{chatId} {

      function isChatMember() {
        return signedIn()
               && resource != null
               && request.auth.uid in resource.data.memberIds;
      }

      // Admin powers exist for groups and for community rooms, and nowhere
      // else. A DM has a `createdBy` too, and treating that as admin handed
      // whoever sent the first message the right to accept the conversation on
      // the other person's behalf and to delete their replies — which is the
      // request gate inverted.
      function isChatAdmin() {
        return signedIn()
               && resource != null
               && (
                 (resource.data.kind == 'group'
                  && (resource.data.createdBy == request.auth.uid
                      || resource.data.admins.hasAny([request.auth.uid])))
                 || (resource.data.kind == 'community'
                     && isCommunityMod(resource.data.get('communityId', '')))
               );
      }

      // Whether `other` accepts a first message from the person asking.
      //
      // This is the request gate, and it lives here rather than only in the
      // client because a gate the client enforces is a gate anyone can skip by
      // not using the client. `following` means *they* follow *you* — the
      // direction matters: it says they have shown interest in you, not the
      // reverse, which anyone can do to anyone.
      function dmAllowedBy(other) {
        return get(/databases/$(database)/documents/users/$(other))
                 .data.get('privacy', {}).get('dmMode', 'following') == 'everyone'
               || (get(/databases/$(database)/documents/users/$(other))
                     .data.get('privacy', {}).get('dmMode', 'following') == 'following'
                   && exists(/databases/$(database)/documents/users/$(other)/following/$(request.auth.uid)));
      }

      // resource == null so a listener on a declined or deleted conversation
      // resolves to "gone" rather than to a permission error.
      allow read: if signedIn() && (resource == null || isChatMember());

      // A DM. The id is derived from the two uids so the conversation is unique
      // by construction; checking it here is what stops someone creating a
      // second one under a name of their choosing and slipping past the gate on
      // the first.
      function validDm() {
        return request.resource.data.memberIds.size() == 2
               && request.auth.uid in request.resource.data.memberIds
               && chatId == (request.resource.data.memberIds[0] < request.resource.data.memberIds[1]
                             ? request.resource.data.memberIds[0] + '_' + request.resource.data.memberIds[1]
                             : request.resource.data.memberIds[1] + '_' + request.resource.data.memberIds[0])
               // Only the initiator has accepted. Marking both accepted at
               // creation would drop the conversation straight into the other
               // person's inbox, which is the gate removed.
               && request.resource.data.acceptedBy == [request.auth.uid]
               && !isBlockedBy(otherIn(request.resource.data.memberIds))
               && dmAllowedBy(otherIn(request.resource.data.memberIds));
      }

      function validGroup() {
        return request.auth.uid in request.resource.data.memberIds
               && request.resource.data.memberIds.size() <= 100
               && request.resource.data.admins == [request.auth.uid]
               && request.resource.data.title is string
               && request.resource.data.title.size() > 0
               && request.resource.data.title.size() <= 80;
      }

      // A community room. Anyone in the community may open it, and the first
      // one to do so creates it.
      function validCommunityRoom() {
        return chatId == 'community_' + request.resource.data.get('communityId', '')
               && isCommunityMember(request.resource.data.get('communityId', ''))
               && request.resource.data.memberIds == [request.auth.uid];
      }

      allow create: if isRegistered()
                    && request.resource.data.createdBy == request.auth.uid
                    // Counters and the preview line are Function-owned. A chat
                    // arriving with them pre-filled is a chat lying about its
                    // own history.
                    && !request.resource.data.keys()
                         .hasAny(['unread', 'lastMessage', 'updatedAt'])
                    && (
                      (request.resource.data.kind == 'dm' && validDm())
                      || (request.resource.data.kind == 'group' && validGroup())
                      || (request.resource.data.kind == 'community'
                          && validCommunityRoom())
                    );

      // What a member may change about a conversation.
      //
      // Separate cases rather than one permissive rule, because the interesting
      // failure here is not someone editing a title — it is someone editing
      // their own unread count, or adding themselves to a group.
      function onlyChanged(fields) {
        return request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(fields);
      }

      // Zeroing your own badge. `unread` is a map, and diffing the map itself
      // is what proves no other person's count was touched.
      function clearingMyBadge() {
        return onlyChanged(['unread'])
               && request.resource.data.unread.diff(resource.data.unread)
                    .affectedKeys().hasOnly([request.auth.uid])
               && request.resource.data.unread[request.auth.uid] == 0;
      }

      // Accepting a request, or replying to one — the same write either way.
      function acceptingRequest() {
        return onlyChanged(['acceptedBy'])
               && request.resource.data.acceptedBy.hasAll(resource.data.acceptedBy)
               && request.resource.data.acceptedBy
                    .removeAll(resource.data.acceptedBy) == [request.auth.uid];
      }

      // Leaving. Removes exactly yourself, from every list you are on.
      function leaving() {
        return onlyChanged(['memberIds', 'acceptedBy', 'admins', 'members'])
               && !(request.auth.uid in request.resource.data.memberIds)
               && resource.data.memberIds
                    .removeAll(request.resource.data.memberIds) == [request.auth.uid];
      }

      // Joining a community room you are entitled to be in.
      function joiningRoom() {
        return resource != null
               && resource.data.kind == 'community'
               && isCommunityMember(resource.data.get('communityId', ''))
               && onlyChanged(['memberIds', 'acceptedBy', 'members'])
               && request.resource.data.memberIds
                    .removeAll(resource.data.memberIds) == [request.auth.uid];
      }

      allow update: if isRegistered()
                    && (
                      (isChatMember() && clearingMyBadge())
                      || (isChatMember() && acceptingRequest())
                      || (isChatMember() && leaving())
                      || joiningRoom()
                      // Group housekeeping: the title, the photo, and who is in
                      // it. Never the counters.
                      || (isChatAdmin()
                          && onlyChanged(['title', 'photoUrl', 'memberIds',
                                          'members', 'admins', 'acceptedBy']))
                    );

      // Declining a request, or a group's creator closing it. A DM only one
      // side ever accepted is not a conversation, so either party may remove it
      // outright rather than leave a delivered-looking message stranded in the
      // sender's list.
      allow delete: if signedIn()
                    && resource != null
                    && (
                      (resource.data.kind == 'dm'
                       && request.auth.uid in resource.data.memberIds
                       && resource.data.acceptedBy.size() < 2)
                      || (resource.data.createdBy == request.auth.uid
                          && resource.data.kind == 'group')
                      || isModerator()
                    );

      match /messages/{messageId} {
        function inThisChat() {
          return signedIn()
                 && exists(/databases/$(database)/documents/chats/$(chatId))
                 && request.auth.uid in
                      get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
        }

        allow read: if inThisChat() || isModerator();

        allow create: if isRegistered()
                      && inThisChat()
                      && request.resource.data.author.uid == request.auth.uid
                      && (request.resource.data.author.verified == false
                          || isVerified())
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 4000
                      // A system message is written by a Function announcing
                      // who joined or left. A client claiming to be one could
                      // put words in the room's mouth.
                      && request.resource.data.kind != 'system';

        // Messages are not editable. A conversation where what was said can
        // change after the fact is not a record of anything, and an "edited"
        // badge is a lot of machinery for something nobody here asked for.
        allow update: if false;

        allow delete: if signedIn()
                      && (resource.data.author.uid == request.auth.uid
                          || isChatAdminOf(chatId)
                          || isModerator());
      }
    }

    match /viewEvents/{eventId} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.targetType in ['recipe', 'plan', 'post'];
      allow read, update, delete: if false;
    }

    // ---- moderation -------------------------------------------------------

    match /reports/{reportId} {
      allow create: if isRegistered()
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isModerator();
      allow delete: if false;
    }

    match /verificationRequests/{uid} {
      allow read: if isSelf(uid) || isModerator();
      allow create: if isSelf(uid) && isRegistered()
                    && request.resource.data.status == 'pending';
      allow update: if isModerator();
      allow delete: if false;
    }

    // ---- reference data ---------------------------------------------------

    match /ingredients/{id} {
      allow read: if true; // needed before sign-in for the composer autocomplete
      allow write: if isModerator();
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---- "which communities am I in" ---------------------------------------
    //
    // A collection-group query over member rows, and it needs its own rule: the
    // nested match under /communities/{cid} never applies to one, because there
    // is no cid to bind. Without this the query falls straight through to the
    // deny-all below — which is exactly what it did.
    //
    // The condition reads `resource`, which a list rule normally cannot do.
    // Here it can, because the app's query carries `where('uid', '==', myUid)`
    // and Firestore can prove every result satisfies the rule from that
    // constraint alone. Drop the filter and the query is denied — which is the
    // behaviour we want, since without it this would list the whole app's
    // memberships.
    match /{path=**}/members/{memberUid} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Anything not matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
