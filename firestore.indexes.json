{
  "indexes": [
    {
      "_comment": "Discover feed. One composite index serves the whole ranked feed; the verified boost lives inside `score`, not in a separate query.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "score",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Following feed — strictly chronological, no ranking, no boost.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "author.uid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Search: keyword match narrowed by region, ranked.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "keywords",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "score",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Browse by region and language, e.g. the regional rails.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "language",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "region",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "score",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Seasonal hubs — Ramadan, Eid, Newroz collections.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "occasions",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "score",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "\"This week in Iraqi kitchens\" — public plans for the current week, most-copied first.",
      "collectionGroup": "plans",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "visibility",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "weekStart",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "stats.copies",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "A user's plan archive on their profile.",
      "collectionGroup": "plans",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "owner.uid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "weekStart",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Plans filtered by tag — \"economical week\", \"student budget\".",
      "collectionGroup": "plans",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "visibility",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "tags",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "weekStart",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Chat list: every conversation you're in, most recent first.",
      "collectionGroup": "chats",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "memberIds",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Moderation queue.",
      "collectionGroup": "reports",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "My recipes, drafts included. Dropping the status filter means the (status, author.uid, createdAt) index no longer applies — a composite index only serves a query that uses its leading fields.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "author.uid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "createdAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Plans rail filtered by tag — \"economical week\", \"student budget\".",
      "collectionGroup": "plans",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "visibility",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "weekStart",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "tags",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "stats.copies",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Plans rail filtered by region.",
      "collectionGroup": "plans",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "visibility",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "weekStart",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "region",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "stats.copies",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Auto-hide counts distinct reporters for one target, so the threshold is about people rather than clicks.",
      "collectionGroup": "reports",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "targetId",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "People search: a display-name prefix range, limited to accounts that have not opted out of being discoverable.",
      "collectionGroup": "users",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "privacy.discoverable",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "displayName",
          "order": "ASCENDING"
        }
      ]
    },
    {
      "_comment": "Search narrowed by region. The keyword+score index does not serve it: adding an equality field to a query needs that field in the index too.",
      "collectionGroup": "recipes",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "keywords",
          "arrayConfig": "CONTAINS"
        },
        {
          "fieldPath": "region",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "status",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "score",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Which communities am I in. A collection-group query over member documents, which is why each one carries a redundant `uid` field — document ids are not queryable across parents.",
      "collectionGroup": "members",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        {
          "fieldPath": "uid",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "joinedAt",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Community directory, filtered by category. Ordered by member count: in a short list the useful signal is where the people are, not what is newest.",
      "collectionGroup": "communities",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "category",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "memberCount",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Community directory, filtered by region.",
      "collectionGroup": "communities",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "region",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "memberCount",
          "order": "DESCENDING"
        }
      ]
    },
    {
      "_comment": "Community directory with both filters applied.",
      "collectionGroup": "communities",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "category",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "region",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "memberCount",
          "order": "DESCENDING"
        }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "_comment": "Recipe steps and ingredients are never queried, only read with the document. Exempting them from indexing cuts write cost and index storage on every recipe.",
      "collectionGroup": "recipes",
      "fieldPath": "steps",
      "indexes": []
    },
    {
      "collectionGroup": "recipes",
      "fieldPath": "ingredients",
      "indexes": []
    },
    {
      "_comment": "Same for the plan's day array — it's read as part of the document, never filtered on.",
      "collectionGroup": "plans",
      "fieldPath": "days",
      "indexes": []
    },
    {
      "_comment": "Saves live under each user, so the nightly recount counts them with a collection-group query. Collection-group scope has to be declared explicitly; the automatic single-field index only covers collection scope.",
      "collectionGroup": "saved",
      "fieldPath": "recipeId",
      "indexes": [
        {
          "order": "ASCENDING",
          "queryScope": "COLLECTION"
        },
        {
          "order": "ASCENDING",
          "queryScope": "COLLECTION_GROUP"
        }
      ]
    }
  ]
}
